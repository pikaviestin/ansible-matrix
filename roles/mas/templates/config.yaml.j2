# Sections managed by the role. Reference:
# https://element-hq.github.io/matrix-authentication-service/reference/configuration.html
http:
  listeners:
    - name: web
      resources:
        - name: discovery
        - name: human
        - name: oauth
        - name: compat
        - name: graphql
        - name: assets
      binds:
        - host: {{ mas_bind_address }}
          port: {{ mas_port }}
      proxy_protocol: false
    - name: internal
      resources:
        - name: health
      binds:
        - host: {{ mas_bind_address }}
          port: {{ mas_internal_port }}
      proxy_protocol: false
  trusted_proxies: {{ mas_trusted_proxies | to_json }}
  public_base: {{ mas_public_base | to_json }}
  issuer: {{ mas_issuer | to_json }}
{% if mas_psql_user | length > 0 %}

database:
  host: {{ mas_psql_host | to_json }}
  port: {{ mas_psql_port }}
  username: {{ mas_psql_user | to_json }}
  password: {{ mas_psql_pw | to_json }}
  database: {{ mas_psql_db | to_json }}
{% endif %}

secrets:
  encryption: {{ mas_encryption_secret_effective | to_json }}
  keys: {{ mas_secrets_keys_effective | to_json }}

matrix:
  kind: synapse
  homeserver: {{ mas_matrix_homeserver | to_json }}
  secret: {{ mas_shared_secret | to_json }}
  endpoint: {{ mas_synapse_endpoint | to_json }}
{% if mas_passwords | length > 0 %}

passwords: {{ mas_passwords | to_json }}
{% endif %}
{% if mas_email | length > 0 %}

email: {{ mas_email | to_json }}
{% endif %}
{% if mas_upstream_oauth2_providers | length > 0 %}

upstream_oauth2:
  providers: {{ mas_upstream_oauth2_providers | to_json }}
{% endif %}
